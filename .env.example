# Copy this file to ".env" and edit the copy.
# ".env" is ignored by git. NEVER put real keys in ".env.example".

# ---------------------------------------------------------------
# Brain (chat model). Any server that speaks the OpenAI-style API.
# ---------------------------------------------------------------
LLM_PROVIDER=openai_compatible

# Option A (default): local Ollama. No key needed.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma4:e4b
LLM_API_KEY=

# Option B: a cloud service. Uncomment, and fill in your own key in ".env".
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=<model name from your provider>
# LLM_API_KEY=<your key here>

# The model's context window in tokens: how much text it can hold at once.
# The app warns you when a request probably does not fit. Ollama's default is
# 4096 on most home computers. If you raise it in Ollama (see "Context window"
# in the README), put the same number here. Use 0 to switch the warning off.
LLM_CONTEXT_TOKENS=4096

# Seconds to wait for the model. Local models can be slow on first load.
LLM_TIMEOUT=360

# ---------------------------------------------------------------
# Mouth (text to speech), used by every feature that speaks.
# ---------------------------------------------------------------
# "browser" (default): your browser's built-in voices. Nothing to install.
# "openai_compatible": a local or cloud speech server (see README, "Voices").
TTS_PROVIDER=browser

# Only for TTS_PROVIDER=openai_compatible:
# TTS_BASE_URL=<the server's API address, usually ending in /v1>
# TTS_MODEL=<speech model name>
# TTS_VOICE=<voice name, if the server needs one>
# TTS_API_KEY=<your key here, or leave empty for a local server>
TTS_TIMEOUT=60

# ---------------------------------------------------------------
# Ear (speech to text), used by the features with a microphone.
# ---------------------------------------------------------------
# "faster_whisper" (default): Whisper on your PC.
#     Install once with:  pip install -r requirements-voice.txt
# "openai_compatible": a local or cloud transcription server.
STT_PROVIDER=faster_whisper
STT_MODEL=small
STT_DEVICE=cpu

# Only for STT_PROVIDER=openai_compatible:
# STT_BASE_URL=<the server's API address, usually ending in /v1>
# STT_API_KEY=<your key here, or leave empty for a local server>
STT_TIMEOUT=120

# ---------------------------------------------------------------
# History and mistake review.
# ---------------------------------------------------------------
# Finished results are kept in this file on your PC (the "data" folder is
# ignored by git). Give another path to keep it somewhere else.
# HISTORY_DB=data/history.db
